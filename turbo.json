{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["ANTHROPIC_API_KEY", "DATABASE_URL", "VOYAGE_API_KEY"]
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
